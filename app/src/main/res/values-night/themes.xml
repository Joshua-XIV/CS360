<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dark_background</item>
        <item name="colorPrimaryVariant">@color/dark_surface</item>
        <item name="colorOnPrimary">@color/dark_text</item>
        <item name="colorSecondary">@color/dark_text</item>
        <item name="colorOnSecondary">@color/dark_background</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:textColorPrimary">@color/text_color_primary</item>
        <item name="android:textColorSecondary">#AAAAAA</item>
        <item name="android:textColorHint">#BBBBBB</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="colorAccent">@color/dark_text</item>
        <item name="colorSurface">@color/dark_background</item>
        <item name="colorOnSurface">@color/dark_text</item>
    </style>
    <style name="Theme.MyApplication.WithActionBar" parent="Theme.MyApplication">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>
</resources>