<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryVariant">#16213E</item>
        <item name="colorOnPrimary">#F5F5F5</item>
        <item name="colorSecondary">#F5F5F5</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorError">#D32F2F</item>
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#AAAAAA</item>
        <item name="android:textColorHint">#BBBBBB</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="colorAccent">?attr/colorSecondary</item>
        <item name="alertDialogTheme">@style/AlertDialogStyle</item>
    </style>
    <style name="Theme.MyApplication.WithActionBar" parent="Theme.MyApplication">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>
    <style name="AlertDialogStyle" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
    </style>
    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>
</resources>